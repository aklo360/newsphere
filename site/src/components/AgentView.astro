---
---

<div id="agent-view" class="persona-content" data-visible="false">
  <div class="max-w-3xl mx-auto px-6">
    
    <!-- Header -->
    <div class="pb-10 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">For Agents</h2>
      <p class="text-lg text-gray-500">
        Two ways to integrate: ACP skill or direct x402 API.
      </p>
    </div>

    <!-- Option 1: ACP -->
    <div class="pb-12">
      <h3 class="text-xl font-bold mb-4">Option 1: ACP Skill</h3>
      <p class="text-gray-500 text-sm mb-4">For OpenClaw agents on Virtuals Protocol</p>
      <div class="code-block" data-code>
        <pre><code>clawhub install opengfx</code></pre>
        <button class="copy-btn" aria-label="Copy code" type="button">
          <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
    </div>

    <!-- Agent Wallet -->
    <div class="pb-8">
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Agent Wallet</div>
      <div class="code-block" data-code>
        <pre><code>0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e</code></pre>
        <button class="copy-btn" aria-label="Copy code" type="button">
          <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
    </div>

    <!-- Offerings (simple list) -->
    <div class="pb-8">
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Offerings</div>
      <div class="rounded-xl border border-gray-200 overflow-hidden text-sm">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
          <code class="font-mono text-gray-700">logo</code>
          <span class="text-gray-500">Logo system + style guide — $5</span>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
          <code class="font-mono text-gray-700">mascot</code>
          <span class="text-gray-500">6-pose mascot sheet — $5</span>
        </div>
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
          <code class="font-mono text-gray-700">social</code>
          <span class="text-gray-500">Avatar + banners — $5</span>
        </div>
        <div class="flex items-center justify-between px-5 py-3">
          <code class="font-mono text-gray-700">gfx</code>
          <span class="text-gray-500">On-brand graphic — $2</span>
        </div>
      </div>
    </div>

    <!-- Example ACP Jobs -->
    <div class="pb-12">
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Example Jobs</div>
      
      <div class="space-y-4">
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e logo \
  --requirements '&#123;"concept":"AI fitness app"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>

        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e mascot \
  --requirements '&#123;"prompt":"Cute owl mascot, purple"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>

        <div class="code-block text-left" data-code>
          <pre><code>acp job status &lt;jobId&gt;</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Option 2: x402 -->
    <div class="pb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 text-xs font-medium text-cyan-600 mb-4">
        x402 Protocol
      </div>
      <h3 class="text-xl font-bold mb-2">Option 2: Direct API</h3>
      <p class="text-gray-500 text-sm mb-6">Pay-per-request via HTTP 402. No API keys needed.</p>

      <div class="mb-6">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Base URL</div>
        <div class="code-block" data-code>
          <pre><code>https://gateway.opengfx.app</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-6">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Endpoints</div>
        <div class="rounded-xl border border-gray-200 overflow-hidden text-sm">
          <div class="flex items-center gap-4 px-5 py-3 border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/logo</code>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/mascot</code>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/socials</code>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/gfx</code>
          </div>
          <div class="flex items-center gap-4 px-5 py-3">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-green-100 text-green-700">GET</span>
            <code class="text-gray-700 font-mono">/v1/jobs/:id</code>
          </div>
        </div>
      </div>

      <div class="mb-6">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Payment Chains</div>
        <div class="flex gap-4 text-sm">
          <div class="px-4 py-2 rounded-lg border border-gray-200">
            <span class="font-semibold">USDC</span>
            <span class="text-gray-400 ml-1">Base</span>
          </div>
          <div class="px-4 py-2 rounded-lg border border-gray-200">
            <span class="font-semibold">SOL</span>
            <span class="text-gray-400 ml-1">Solana</span>
          </div>
        </div>
      </div>

      <div class="mb-6">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Payment Flow</div>
        <div class="text-sm text-gray-600 space-y-2">
          <div><span class="text-cyan-600 font-semibold">1</span> POST to endpoint → receive HTTP 402 with payment options</div>
          <div><span class="text-cyan-600 font-semibold">2</span> Sign payment (USDC on Base or SOL on Solana)</div>
          <div><span class="text-cyan-600 font-semibold">3</span> Retry with <code class="px-1 bg-gray-100 rounded">X-Payment</code> header → receive job ID</div>
          <div><span class="text-cyan-600 font-semibold">4</span> Poll <code class="px-1 bg-gray-100 rounded">/v1/jobs/:id</code> until complete → get CDN URLs</div>
        </div>
      </div>

      <div>
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Example Request</div>
        <div class="code-block text-left" data-code>
          <pre><code>curl -X POST https://gateway.opengfx.app/v1/logo \
  -H "Content-Type: application/json" \
  -d '&#123;"concept":"Modern fintech"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Links -->
    <div class="text-center pb-8">
      <div class="flex items-center justify-center gap-6 text-sm">
        <a href="https://gateway.opengfx.app" target="_blank" rel="noopener" class="text-cyan-500 hover:text-cyan-600 font-medium">API Docs ↗</a>
        <a href="https://clawhub.com/skills/opengfx" target="_blank" rel="noopener" class="text-cyan-500 hover:text-cyan-600 font-medium">ClawHub ↗</a>
        <a href="https://github.com/aklo360/opengfx-skill" target="_blank" rel="noopener" class="text-cyan-500 hover:text-cyan-600 font-medium">GitHub ↗</a>
      </div>
    </div>

  </div>
</div>
