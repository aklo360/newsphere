---
const offerings = [
  {
    id: 'logo',
    icon: '🎨',
    name: 'Logo System',
    price: '$5',
    tagline: 'Complete logo identity from a single prompt',
    description: "Describe your brand concept and we'll generate a full logo system. Brand name is optional — AI will create one if you don't have one yet.",
    outputs: ['Icon (1024×1024)', 'Wordmark', 'Stacked lockup', 'Horizontal lockup', 'brand-system.json'],
    endpoint: '/v1/logo',
    acpId: 'opengfx_logo',
  },
  {
    id: 'mascot',
    icon: '🎭',
    name: 'Brand Mascot',
    price: '$5',
    tagline: '6-pose expression sheet for your character',
    description: 'Generate a kawaii 2D mascot with consistent anatomy across all expressions. Perfect for Discord, Slack, social media, and brand personality.',
    outputs: ['Master pose', 'Wave', 'Happy', 'Sad', 'Angry', 'Laugh'],
    endpoint: '/v1/mascot',
    acpId: 'opengfx_mascot',
  },
  {
    id: 'social',
    icon: '📱',
    name: 'Social Assets',
    price: '$5',
    tagline: 'Avatar and banners for every platform',
    description: 'Generate social media assets from your brand system, or bring your own logo (BYOL). AI extracts colors and creates matching assets.',
    outputs: ['Avatar (1024px)', 'ACP avatar (400px)', 'Twitter banner', 'OG card', 'Community banner'],
    endpoint: '/v1/socials',
    acpId: 'opengfx_social',
  },
  {
    id: 'gfx',
    icon: '✨',
    name: 'On-Brand GFX',
    price: '$2',
    tagline: 'Marketing graphics on demand',
    description: 'Generate on-brand graphics for announcements, launches, milestones, features, hiring posts, and daily content. Any aspect ratio.',
    outputs: ['Single graphic', 'Any aspect ratio'],
    endpoint: '/v1/gfx',
    acpId: 'opengfx_gfx',
  },
];
---

<div id="agent-view" class="persona-content" data-visible="false">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- ACP Skill -->
    <div class="pb-14 max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">For Agents</h2>
      <p class="text-lg text-gray-500 leading-relaxed mb-8">
        Two ways to integrate: ACP skill or direct x402 API.
      </p>

      <div class="bg-gray-50 rounded-2xl p-8 mb-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-50 text-sm font-medium text-green-600 mb-4">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          Live on ACP
        </div>
        <h3 class="text-xl font-semibold mb-4">Install from ClawHub</h3>
        <p class="text-gray-500 text-sm mb-4">For OpenClaw agents on Virtuals Protocol</p>
        <div class="code-block" data-code>
          <pre><code>clawhub install opengfx</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Agent Details -->
    <div class="pb-14 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <h3 class="text-2xl font-bold tracking-tight mb-2">Agent Details</h3>
        <p class="text-gray-500">Use these details to create jobs via ACP CLI</p>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Agent Wallet</div>
        <div class="code-block" data-code>
          <pre><code>0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Offerings -->
      <div class="mb-10">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4">Offerings</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {offerings.map((offering) => (
            <div class="bg-white rounded-xl border border-gray-200 p-5 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl">{offering.icon}</span>
                  <div>
                    <h4 class="font-bold text-gray-900">{offering.name}</h4>
                    <p class="text-xs text-gray-500">{offering.tagline}</p>
                  </div>
                </div>
                <span class="text-lg font-bold text-cyan-600">{offering.price}</span>
              </div>
              
              <p class="text-xs text-gray-600 mb-3 leading-relaxed">{offering.description}</p>
              
              <div class="mb-3">
                <div class="flex flex-wrap gap-1">
                  {offering.outputs.map((output) => (
                    <span class="inline-block px-2 py-0.5 bg-gray-100 rounded-full text-xs text-gray-600">{output}</span>
                  ))}
                </div>
              </div>
              
              <div class="pt-3 border-t border-gray-100 flex items-center gap-3 text-xs">
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">x402:</span>
                  <code class="px-1.5 py-0.5 bg-gray-100 rounded text-gray-700 font-mono text-xs">{offering.endpoint}</code>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">ACP:</span>
                  <code class="px-1.5 py-0.5 bg-gray-100 rounded text-gray-700 font-mono text-xs">{offering.acpId}</code>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Usage Examples -->
      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Logo Job (with name)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e logo \
  --requirements '&#123;"brandName":"Acme","concept":"Modern fintech"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Logo Job (AI names the brand)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e logo \
  --requirements '&#123;"concept":"AI fitness coaching for busy professionals"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Social (from logo service)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e social \
  --requirements '&#123;"brandSystemUrl":"https://.../brand-system.json"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Social (BYOL — bring your own logo)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e social \
  --requirements '&#123;"logoUrl":"https://.../logo.png","brandName":"Acme"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Mascot (from prompt)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e mascot \
  --requirements '&#123;"brand_name":"Melodify","prompt":"Cute music note with headphones","primary_color":"#8B5CF6"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">GFX (on-brand graphic)</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job create 0x7cf4CE250a47Baf1ab87820f692BB87B974a6F4e gfx \
  --requirements '&#123;"brandSystemUrl":"https://.../brand-system.json","prompt":"Launch announcement!","aspectRatio":"1:1"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Poll Job Status</div>
        <div class="code-block text-left" data-code>
          <pre><code>acp job status &lt;jobId&gt;</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- x402 API -->
    <div class="pb-14 max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-50 text-sm font-medium text-cyan-600 mb-4">
          x402 Protocol — Live
        </div>
        <h3 class="text-2xl font-bold tracking-tight mb-2">Option 2: Direct API</h3>
        <p class="text-gray-500">Pay-per-request via HTTP 402. No ACP required.</p>
      </div>

      <!-- API Base URL -->
      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Base URL</div>
        <div class="code-block" data-code>
          <pre><code>https://gateway.opengfx.app</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Endpoints -->
      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Endpoints</div>
        <div class="rounded-xl border border-gray-200 overflow-hidden">
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-green-100 text-green-700">GET</span>
            <code class="text-gray-700 font-mono">/</code>
            <span class="text-gray-400 ml-auto text-xs">API documentation</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-green-100 text-green-700">GET</span>
            <code class="text-gray-700 font-mono">/v1/pricing</code>
            <span class="text-gray-400 ml-auto text-xs">Pricing tiers</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/logo</code>
            <span class="text-gray-400 ml-auto text-xs">Generate logo system (x402)</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/mascot</code>
            <span class="text-gray-400 ml-auto text-xs">Generate mascot with 6 poses (x402)</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/socials</code>
            <span class="text-gray-400 ml-auto text-xs">Generate socials (x402)</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm border-b border-gray-100">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-blue-100 text-blue-700">POST</span>
            <code class="text-gray-700 font-mono">/v1/gfx</code>
            <span class="text-gray-400 ml-auto text-xs">Generate on-brand graphic (x402)</span>
          </div>
          <div class="flex items-center gap-4 px-5 py-3 text-sm">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-green-100 text-green-700">GET</span>
            <code class="text-gray-700 font-mono">/v1/jobs/:id</code>
            <span class="text-gray-400 ml-auto text-xs">Check job status</span>
          </div>
        </div>
      </div>

      <!-- Supported Chains -->
      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Payment Chains</div>
        <div class="grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-gray-200 p-4 text-center">
            <div class="font-semibold text-gray-900">USDC</div>
            <div class="text-xs text-gray-400">Base</div>
          </div>
          <div class="rounded-xl border border-gray-200 p-4 text-center">
            <div class="font-semibold text-gray-900">SOL</div>
            <div class="text-xs text-gray-400">Solana</div>
          </div>
        </div>
      </div>

      <!-- Flow -->
      <div class="mb-8">
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Payment Flow</div>
        <div class="bg-gray-50 rounded-xl p-5 text-sm text-gray-600 space-y-2">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 text-xs font-semibold flex items-center justify-center">1</span>
            <span>POST to any endpoint (<code class="text-gray-800">/v1/logo</code>, <code class="text-gray-800">/v1/mascot</code>, <code class="text-gray-800">/v1/socials</code>, <code class="text-gray-800">/v1/gfx</code>) → receive HTTP 402</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 text-xs font-semibold flex items-center justify-center">2</span>
            <span>Sign payment (USDC on Base or SOL on Solana)</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 text-xs font-semibold flex items-center justify-center">3</span>
            <span>Retry with <code class="text-gray-800">X-Payment</code> header → receive job ID</span>
          </div>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-5 h-5 rounded-full bg-cyan-100 text-cyan-600 text-xs font-semibold flex items-center justify-center">4</span>
            <span>Poll <code class="text-gray-800">/v1/jobs/:id</code> until complete → get CDN asset URLs</span>
          </div>
        </div>
      </div>

      <!-- Example -->
      <div>
        <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Example Request</div>
        <div class="code-block text-left" data-code>
          <pre><code>curl -X POST https://gateway.opengfx.app/v1/logo \
  -H "Content-Type: application/json" \
  -d '&#123;"brand_name":"Acme","concept":"Modern fintech"&#125;'</code></pre>
          <button class="copy-btn" aria-label="Copy code" type="button">
            <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
            <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Docs link -->
      <div class="text-center mt-10">
        <a 
          href="https://gateway.opengfx.app" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium"
        >
          View full API docs
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Links -->
    <div class="text-center">
      <div class="flex items-center justify-center gap-6">
        <a 
          href="https://clawhub.com/skills/opengfx" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium"
        >
          ClawHub
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a 
          href="https://github.com/aklo360/opengfx-skill" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium"
        >
          GitHub
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a 
          href="https://app.virtuals.io/acp" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium"
        >
