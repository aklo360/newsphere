---
---

<div id="agent-view" class="persona-content" data-visible="false">
  <div class="max-w-2xl mx-auto px-6 text-center">
    
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">For Agents</h2>
    <p class="text-lg text-gray-500 mb-10">
      Integrate via ACP skill or x402 API.
    </p>

    <!-- Option 1: ClawHub -->
    <div class="mb-8">
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Option 1: ClawHub</div>
      <div class="code-block mb-4" data-code>
        <pre><code>clawhub install opengfx</code></pre>
        <button class="copy-btn" aria-label="Copy code" type="button">
          <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
      <a 
        href="https://clawhub.com/skills/opengfx" 
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium text-sm"
      >
        View on ClawHub ↗
      </a>
    </div>

    <!-- Option 2: Self-hosted -->
    <div class="mb-10">
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Option 2: Self-hosted SKILL.md</div>
      <div class="code-block mb-4" data-code>
        <pre><code>https://opengfx.app/skill.md</code></pre>
        <button class="copy-btn" aria-label="Copy code" type="button">
          <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg class="w-4 h-4 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
      <a 
        href="/skill.md" 
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-cyan-500 hover:text-cyan-600 font-medium text-sm"
      >
        View SKILL.md ↗
      </a>
    </div>

    <p class="text-sm text-gray-400">
      Full ACP &amp; x402 integration guides included.
    </p>

  </div>
</div>
