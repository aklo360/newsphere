<section class="pt-24 pb-8 md:pt-32 md:pb-12">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <!-- Logo -->
    <div class="mb-4 flex justify-center">
      <img
        src="/logo.png?v=2"
        alt="OpenGFX"
        class="h-20 md:h-24 w-auto"
        width="512"
        height="512"
      />
    </div>

    <!-- Brand name -->
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 mb-10">OpenGFX</h2>

    <!-- Headline -->
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-gray-900 mb-4">
      AI-Powered<br />
      <span class="bg-gradient-to-r from-cyan-500 to-teal-500 bg-clip-text text-transparent">
        Brand Design
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="text-xl md:text-2xl text-gray-500 max-w-2xl mx-auto leading-relaxed mb-10">
      Complete logo systems and social assets, generated in minutes from a single prompt.
    </p>

    <!-- CTA Button - Coming Soon state -->
    <div class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gray-100 text-gray-500 font-semibold text-lg">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Web App Coming Soon
    </div>
  </div>
</section>
