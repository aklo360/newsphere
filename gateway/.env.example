# OpenGFX x402 Gateway Configuration

# Network mode: mainnet or testnet
NETWORK_MODE=mainnet

# EVM (Base) wallet address to receive payments
WALLET_ADDRESS=0x...

# Solana wallet address to receive payments
SOLANA_WALLET_ADDRESS=...

# Private key for settling EVM payments (transferWithAuthorization)
SETTLEMENT_PRIVATE_KEY=0x...

# Solana private key (base58) - only needed if submitting pre-signed txs
SOLANA_PRIVATE_KEY=...

# API base URL for job persistence (optional)
API_BASE_URL=https://api.opengfx.app

# Port
PORT=4022

# Path to OpenGFX workspace (relative from gateway/)
OPENGFX_PATH=..
