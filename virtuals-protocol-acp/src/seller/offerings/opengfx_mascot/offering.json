{
  "id": "opengfx_mascot",
  "name": "OpenGFX Mascot Generator",
  "description": "Generate a complete brand mascot/character with 6-pose expression sheet. Includes master pose plus 5 emotes (wave, happy, sad, angry, laugh). 2D flat style with consistent anatomy and line weight.",
  "price": {
    "amount": 5,
    "currency": "USDC"
  },
  "category": "design",
  "tags": ["mascot", "character", "brand", "illustration", "expressions"],
  "inputSchema": {
    "type": "object",
    "required": ["brand_name"],
    "properties": {
      "brand_name": {
        "type": "string",
        "description": "Brand name for the mascot"
      },
      "prompt": {
        "type": "string",
        "description": "Natural language description of the mascot (e.g., 'Discord-style crab in blurple'). Required if no master_url."
      },
      "master_url": {
        "type": "string",
        "description": "URL to locked master image. If provided, generates expression sheet from this master."
      },
      "creature": {
        "type": "string",
        "description": "Creature type override (e.g., 'crab', 'owl', 'robot')"
      },
      "primary_color": {
        "type": "string",
        "description": "Primary color in hex (e.g., '#5865F2')"
      },
      "leg_count": {
        "type": "integer",
        "description": "Number of legs. REQUIRED when using master_url."
      },
      "claw_count": {
        "type": "integer",
        "default": 2,
        "description": "Number of claws/arms (default: 2)"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "master": { "type": "string", "description": "CDN URL for master pose" },
      "wave": { "type": "string", "description": "CDN URL for wave expression" },
      "happy": { "type": "string", "description": "CDN URL for happy expression" },
      "sad": { "type": "string", "description": "CDN URL for sad expression" },
      "angry": { "type": "string", "description": "CDN URL for angry expression" },
      "laugh": { "type": "string", "description": "CDN URL for laugh expression" },
      "qc_passed": { "type": "boolean", "description": "Whether all poses passed QC" }
    }
  },
  "estimatedDuration": "2-4 minutes",
  "examples": [
    {
      "input": {
        "brand_name": "Disclaw",
        "prompt": "Discord-style crab mascot in blurple, 4 tiny legs, no antenna"
      },
      "description": "Generate a new mascot from natural language"
    },
    {
      "input": {
        "brand_name": "Disclaw",
        "master_url": "https://cdn.example.com/master.png",
        "leg_count": 4
      },
      "description": "Generate expression sheet from approved master"
    }
  ]
}
