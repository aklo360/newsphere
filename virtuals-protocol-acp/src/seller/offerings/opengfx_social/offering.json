{
  "id": "opengfx_social",
  "name": "OpenGFX Social Assets",
  "description": "Generate social media assets from a brand system or your own logo (BYOL). Includes avatar (1K + 400px ACP), Twitter banner, OG card, and community banner.",
  "price": {
    "amount": 5,
    "currency": "USDC"
  },
  "category": "design",
  "tags": ["social", "avatar", "banner", "twitter", "og-card"],
  "inputSchema": {
    "type": "object",
    "properties": {
      "brand_system_url": {
        "type": "string",
        "description": "URL to brand-system.json from logo service (Mode 1)"
      },
      "logo_url": {
        "type": "string",
        "description": "URL to your existing logo image (BYOL Mode 2)"
      },
      "brand_name": {
        "type": "string",
        "description": "Brand name (required for BYOL mode)"
      },
      "tagline": {
        "type": "string",
        "description": "Optional tagline"
      },
      "primary_color": {
        "type": "string",
        "description": "Primary color hex (auto-extracted if not provided)"
      },
      "secondary_color": {
        "type": "string",
        "description": "Secondary color hex"
      },
      "render_style": {
        "type": "string",
        "enum": ["flat", "flat-solid", "gradient", "glass", "chrome", "gold", "silver", "neon", "3d", "gavin"],
        "description": "Render style for social assets"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "avatarMaster": { "type": "string", "description": "CDN URL for avatar (1024x1024)" },
      "avatarAcp": { "type": "string", "description": "CDN URL for ACP avatar (400x400 JPEG)" },
      "twitterBanner": { "type": "string", "description": "CDN URL for Twitter banner (3000x1000)" },
      "ogCard": { "type": "string", "description": "CDN URL for OG card (1200x628)" },
      "communityBanner": { "type": "string", "description": "CDN URL for community banner (1200x480)" }
    }
  },
  "estimatedDuration": "1-2 minutes",
  "examples": [
    {
      "input": {
        "brand_system_url": "https://pub-156972f0e0f44d7594f4593dbbeaddcb.r2.dev/acme/brand-system.json"
      },
      "description": "Generate from logo service output"
    },
    {
      "input": {
        "logo_url": "https://example.com/my-logo.png",
        "brand_name": "Acme",
        "render_style": "gradient"
      },
      "description": "BYOL with custom render style"
    }
  ]
}
